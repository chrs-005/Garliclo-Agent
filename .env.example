# Which API to use: openai (default) or gemini
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here   (needed only with LLM_PROVIDER=gemini)

# Optional model overrides (defaults depend on the provider)
# LLM_MODEL=gpt-4.1-mini
# LLM_ROUTER_MODEL=gpt-4.1-nano
# LLM_REFLECTION_MODEL=gpt-4.1-mini
# LLM_FALLBACK_MODELS=gpt-4o-mini,gpt-4.1-nano

SHOW_ADMIN_PANEL=true
# PUSHOVER_USER=
# PUSHOVER_TOKEN=
